# Server
TECHUNTER_HOST=0.0.0.0
TECHUNTER_PORT=4310
TECHUNTER_DATA_DIR=.data
TECHUNTER_PUBLIC_URL=http://127.0.0.1:4310
TECHUNTER_WEB_URL=http://127.0.0.1:5173
TECHUNTER_DEMO_MODE=true
TECHUNTER_DEMO_REPO_PATH=..
TECHUNTER_DESKTOP_ZOOM=1.15

# GitHub OAuth login (optional in demo mode)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_ORG=

# GitHub App repository operations (preferred)
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Local development fallback only
GITHUB_TOKEN=

# OpenAI-compatible model (optional; deterministic fallback is built in)
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=z-ai/glm-5
