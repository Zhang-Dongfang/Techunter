{
  "name": "@techunter/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n api,web,desktop -c blue,magenta,yellow \"npm:dev:server\" \"npm:dev:web\" \"npm:dev:desktop\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "dev:desktop": "node scripts/wait-for-dev.mjs && tsup && cross-env TECHUNTER_WEB_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run typecheck && vite build && tsup",
    "start": "node dist/server/index.mjs",
    "desktop": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^10.1.3",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.0",
    "fast-glob": "^3.3.3",
    "fastify": "^5.6.2",
    "fastify-raw-body": "^5.0.0",
    "lucide-react": "^0.468.0",
    "minimatch": "^10.0.1",
    "openai": "^6.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.9"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
