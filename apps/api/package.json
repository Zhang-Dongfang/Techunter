{
  "name": "@techunter/api",
  "version": "0.1.0",
  "private": true,
  "description": "Techunter Railway control-plane API",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/index.ts",
    "migrate:sqlite": "npm run build && node dist/migrate-sqlite.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build --workspace @techunter/core && npm run build && node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.0",
    "@supabase/supabase-js": "^2.110.0",
    "@techunter/core": "0.1.0",
    "fastify": "^5.6.2",
    "fastify-raw-body": "^5.0.0",
    "minimatch": "^10.0.1",
    "tar": "^7.5.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
