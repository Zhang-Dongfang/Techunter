{
  "name": "@techunter/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n web,desktop -c magenta,yellow \"npm:dev:web\" \"npm:dev:desktop\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:desktop": "node scripts/wait-for-dev.mjs && tsup && cross-env TECHUNTER_RENDERER_URL=http://127.0.0.1:5173 TECHUNTER_API_URL=http://127.0.0.1:4310 electron .",
    "build": "npm run typecheck && npm run build:web && tsup",
    "build:web": "vite build",
    "desktop": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build --workspace @techunter/core && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@techunter/core": "0.1.0",
    "lucide-react": "^0.468.0",
    "minimatch": "^10.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.9"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
